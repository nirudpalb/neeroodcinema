{
  "name": "neerood-cinema",
  "version": "1.0.0",
  "description": "NEEROOD CINEMA \u2014 personal movie library",
  "main": "main.js",
  "author": "NEEROOD",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.neerood.cinema",
    "productName": "NEEROOD CINEMA",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
